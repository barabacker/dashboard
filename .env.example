# Copy to .env for local development.

# Lets plain `docker compose ...` find docker/compose.yaml from the repository root.
COMPOSE_FILE=docker/compose.yaml

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Worker runtime (§7, §9)
WORKER_LEASE_SECONDS=900
WORKER_POLL_SECONDS=1.0

# Credential references resolved at execution time (§4) — never snapshotted.
# COLLECTOR_SECRET_DEMO_TOKEN=...
