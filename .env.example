# Скопируйте в .env и правьте под себя: cp .env.example .env
# Файл .env в git не попадает; переменные окружения имеют приоритет над ним.

# --- Django ---
# Обязательно свой ключ перед деплоем: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-change-me-before-deploy
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Путь к файлу базы. В Docker подставляется /data/db.sqlite3
# DJANGO_DB_PATH=db.sqlite3

# --- Control plane ---
# Срок аренды задания: раннер молчит дольше — запуск считается просроченным
CONTROL_LEASE_SECONDS=600
# Сколько дней хранить строки логов (чистит manage.py maintenance)
CONTROL_LOG_RETENTION_DAYS=30
# Рекомендуемый интервал опроса, отдаётся раннеру в ответе claim
CONTROL_POLL_INTERVAL=10

# --- Раннер ---
# Токен создаётся в админке: Парсеры → Раннеры
# RUNNER_TOKEN=
# DASHBOARD_URL=http://127.0.0.1:8000

# --- Docker ---
# Порт, на котором админка доступна на хосте
PORT=8000
